# Telecom Connect Environment Configuration

# Application
APP_NAME="Telecom Connect"
APP_ENV=development
DEBUG=True
API_V1_STR=/api/v1
SECRET_KEY=telecom_connect_super_secret_jwt_key_ahmedabad_2026_dev_only
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120

# Database
# For production PostgreSQL: postgresql+psycopg2://telecom_user:telecom_pass@localhost:5432/telecom_db
# For local / testing fallback: sqlite:///./telecom.db
DATABASE_URL=sqlite:///./telecom.db
DB_ECHO=False

# Redis Cache
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=300
CACHE_ENABLED=True

# Rate Limiting
RATE_LIMIT_PER_MINUTE=100

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000","http://127.0.0.1:8000"]
